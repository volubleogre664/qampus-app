egex = / /gi;\n   const str = textMsg.replace(regex, \"\");\n   if (textMsg === \"\" || str === \"\") return;\n   \n   setMsgs([...messages, textMsg]);\n   setMsg(\"\");\n   document.querySelector(\".sendMsgInput\").value = \"\"; \n }\n\n  return (\n    <body>\n    <div className=\"nav__section\">\n    <img className=\"nav__logo\" src=\"../logo.png\"></img>\n    <nav>\n     \n      <label for=\"mycheckbox\" className=\"menu__button\"> \n      <MenuIcon className=\"menu__icon\"/>\n      {/* <CloseIcon className=\"close__icon\"/> */}\n       </label>\n      <input type=\"checkbox\" id=\"mycheckbox\">\n\n      </input>\n    <ul class=\"nav_links\">\n    <li className=\"link__home\"><a href=\"/\">Home</a></li>\n    <li><a href=\"#\">Upload</a></li>\n    <li><a href=\"#\">Book Collection</a></li>\n    <li className=\"link__chat\"><a href=\"./Chats\">Chats</a></li>\n    <li><a href=\"#\">Navigation</a></li>\n    <li><a href=\"#\">Settings</a></li>\n    <li><a href=\"#\">Help</a></li>\n    <li><a href=\"#\">Profile</a></li>\n    <li><a href=\"./Login\">Logout</a></li>\n    </ul>\n    </nav>\n    </div>\n    <div className=\"chats\">\n    \n      <div className=\"chats__sidebar\">\n        <div className=\"chats__sidebarHeader\">\n          <h2 className=\"title\">Chats</h2>\n\n          <span className=\"icon__container\">\n            <Link className=\"icon__containerLink\" to=\"/\"> \n            <ArrowBackIosIcon />\n            </Link>\n          </span>\n        </div>\n\n        <div className=\"chats__sidebarBody\">\n          <div className=\"search__container\">\n            <input className=\"search__input\" placeholder=\"\" />\n\t          <SearchIcon />\n\t        </div>\n\n          <div className=\"contactSection\">\n            <Contact name=\"James King\" />\n\t          <Contact name=\"Mason Monroe\" />\n\t        </div>\n\n        </div>\n\n        <div className=\"chats__sidebarFooter\">\n          <span className=\"text\">Find a study buddy</span>\n      \t  <ArrowForwardIosIcon />\n        </div>\n\n      </div>\n\n      <div className=\"chats__main\">\n        <div className=\"chats__mainHeader\">\n          <div className=\"left\">\n            <span className=\"iconContainer\">\n              <PersonIcon />\n            </span>\n            <span className=\"name\">Elon</span>\n          </div>\n\n          <div className=\"right\">\n          <label className=\"online__status\">Offline</label>\n          <label className=\"last__seen\">Last seen: Now</label>\n          </div>\n        </div>\n\n        <div className=\"chats__mainBody\">\n          <Message messages={messages} />\n        </div>\n\n        <div className=\"chats__mainFooter\">\n          <form>\n            \n            <button className=\"btnAttach\">\n              <AttachmentIcon />\n            </button>\n\n            <button className=\"btnEmoji\">\n              <EmojiEmotionsIcon />\n            </button>\n\n\n            <input placeholder=\"\" className=\"sendMsgInput\" onChange={handleChange} />\n\n            <button className=\"btnSend\" type=\"submit\" onClick={showMsg}>\n              <SendIcon />\n            </button>\n\n            <button className=\"btnRecord\">\n              <MicIcon />\n            </button>\n\n          </form>\n        </div>\n      </div>\n    </div>\n    </body>\n );\n}\n\nexport default Chats;\n","/root/Downloads/repos/qampus-app/src/Login/Login.js",[],"/root/Downloads/repos/qampus-app/src/Home/Home.js",["56","57","58"],"import React, {useState} from 'react';\nimport SearchIcon from \"@material-ui/icons/Search\";\nimport ArrowBackIcon from \"@material-ui/icons/ArrowBack\";\nimport ArrowForwardIcon  from \"@material-ui/icons/ArrowForward\";\nimport PersonIcon from \"../account-home.png\";\n//import PersonIcon from \"@material-ui/icons/Person\";\nimport MenuItem from \"./MenuItem.js\";\nimport {Link} from \"react-router-dom\";\nimport logo from \"../logo.png\";\nimport searchIcon from \"../searchIcon.png\";\nimport './Home.css';\n\nfunction Home() {\n  return (\n\t\n<div className='home'>\n\t\n    <div className=\"home__header\">\n        <div className=\"home__logo\">\n          <img className=\"home__logoImg\" src={logo} alt=\"qampus logo\" />\n\t\t</div>\n\n\t\t<div className=\"home__avatar\">\n          \t<div className=\"home__avatarIcon\">\n\t\t\t\t<img class=\"avatarIcon\" src={PersonIcon} alt=\"avatar_icon\" />\n\t  \t\t</div>\n\n\t  \t\t<div className=\"home__avatarName\">\n\t\t  \t\tGuest\n\t  \t\t</div>\n\t\t</div>\n\t</div>\n\n    <div className=\"home__searchSection\">\n        <h4 className=\"home__title\">Search for textbooks</h4>\n\t\n\t\t<p className=\"home__subtitle\">\n          Type the ISBN, title or Module Code.\n\t\t</p>\n\n        <div className=\"home__searchContainer\">\t\t\t\t\t\t\t\n\t\t\t<input type=\"text\" name=\"searchBook\" className=\"home__searchInput\" />\n\t\t\t<img class=\"searchButton\" src={searchIcon} alt=\"search_icon\" />\n        </div>\n    </div>\n\n    <div className=\"home__menu\">\n        <span className=\"home__arrowIcon\">\n\t  \t\t<ArrowBackIcon/>\n\t\t</span>\n\n\t\t<div className=\"home__menuItems\">\n          \t<MenuItem\n\t\t    class=\"upload\"\n\t\t\ticon=\"upload\"\n\t    \ttitle=\"Upload\"\n\t    \tsubtitle=\"Upload your used textbooks and sell them to other students.\"\n\t \t\t/>\n\n\t\t   <MenuItem\n\t\t  \tclass=\"collection\"\n            icon=\"collection\"\n\t    \ttitle=\"Book Collection\"\n\t    \tsubtitle=\"Here you will find a collection of all the books you have uploaded.\"\n\t  \t\t/>\n\n\t  \t\t<MenuItem\n\t\t\tclass=\"chat\"\n\t\t\ticon=\"chat\"\n\t\t\ttitle=\"Chats\"\n\t\t\tsubtitle=\"Connect with other students who are registered on Qampus.\"\n\t\t\t/> \n\n\t\t\t<MenuItem\n\t\t\tclass=\"navigation\"\n\t\t\ticon=\"navigation\"\n\t\t\ttitle=\"Navigation\"\n\t\t\tsubtitle=\"Let Qampus Navigator help you find your way around your Campus.\"\n\t\t\t/>\n\t\n\t  \t\t<MenuItem\n\t\t\tclass=\"settings\"\n\t\t\ticon=\"settings\"\n\t\t\ttitle=\"Settings\"\n\t\t\tsubtitle=\"Play around with Qampus settings and customise it to be you.\"\n\t\t\t/>\n\n\t\t\t<span className=\"home__arrowIcon\">\n          \t\t<ArrowForwardIcon />\n\t\t\t</span>\n      \t</div>\n    </div>\n\n</div>\n  );\n}\n\nexport default Home;\n","/root/Downloads/repos/qampus-app/src/Profile/Profile.js",[],"/root/Downloads/repos/qampus-app/src/Chats/Message.js",[],"/root/Downloads/repos/qampus-app/src/Chats/Contact.js",[],"/root/Downloads/repos/qampus-app/src/Home/MenuItem.js",[],["59","60"],{"ruleId":"61","replacedBy":"62"},{"ruleId":"63","replacedBy":"64"},{"ruleId":"65","severity":1,"message":"66","line":7,"column":8,"nodeType":"67","messageId":"68","endLine":7,"endColumn":17},{"ruleId":"69","severity":1,"message":"70","line":37,"column":5,"nodeType":"71","endLine":37,"endColumn":50},{"ruleId":"72","severity":1,"message":"73","line":49,"column":9,"nodeType":"71","endLine":49,"endColumn":21},{"ruleId":"72","severity":1,"message":"73","line":50,"column":9,"nodeType":"71","endLine":50,"endColumn":21},{"ruleId":"72","severity":1,"message":"73","line":52,"column":9,"nodeType":"71","endLine":52,"endColumn":21},{"ruleId":"72","severity":1,"message":"73","line":53,"column":9,"nodeType":"71","endLine":53,"endColumn":21},{"ruleId":"72","severity":1,"message":"73","line":54,"column":9,"nodeType":"71","endLine":54,"endColumn":21},{"ruleId":"72","severity":1,"message":"73","line":55,"column":9,"nodeType":"71","endLine":55,"endColumn":21},{"ruleId":"65","severity":1,"message":"74","line":1,"column":16,"nodeType":"67","messageId":"68","endLine":1,"endColumn":24},{"ruleId":"65","severity":1,"message":"75","line":2,"column":8,"nodeType":"67","messageId":"68","endLine":2,"endColumn":18},{"ruleId":"65","severity":1,"message":"76","line":8,"column":9,"nodeType":"67","messageId":"68","endLine":8,"endColumn":13},{"ruleId":"61","replacedBy":"77"},{"ruleId":"63","replacedBy":"78"},"no-native-reassign",["79"],"n