ch for textbooks</h4>\n\t\n\t<p className=\"home__subtitle\">\n          Type the ISBN, title or Module Code.\n\t</p>\n\n        <div className=\"home__searchContainer\">\n          <input type=\"text\" name=\"searchBook\" className=\"home__searchInput\" />\n\n\t  <SearchIcon />\n        </div>\n      </div>\n\n      <div className=\"home__menu\">\n        <span className=\"home__arrowIcon\">\n\t  <ArrowBackIcon />\n\t</span>\n\n\t<div className=\"home__menuItems\">\n          <MenuItem\n            icon=\"upload\"\n\t    title=\"Upload\"\n\t    subtitle=\"Here you can upload books to sell to other learners\"\n\t  />\n\n\t  <MenuItem\n            icon=\"collection\"\n\t    title=\"Collection\"\n\t    subtitle=\"You can view the collection of books you have uploaded\"\n\t  />\n\n\t  <Link to=\"/chats\">\n\t  <MenuItem\n\t    icon=\"chat\"\n\t    title=\"Chats\"\n\t    subtitle=\"You can chat with people you've worked with before or jump into the QampusChatand chat with everyone.\"\n\t  /> </Link>\n\n\t  <MenuItem\n\t    icon=\"navigation\"\n\t    title=\"Navigation\"\n\t    subtitle=\"Let Qampus Navigator help you find your way around your Campus.\"\n\t  />\n\n\t  <MenuItem\n            icon=\"settings\"\n\t    title=\"Settings\"\n\t    subtitle=\"Play around with Qampus settings and customise it to be you.\"\n\t  />\n\t</div>\n\n\t<span className=\"home__arrowIcon\">\n          <ArrowForwardIcon />\n\t</span>\n      </div>\n    </div>\n  );\n}\n\nexport default Home;\n","/data/data/com.termux/files/home/qampus-app/src/Home/MenuItem.js",[],"/data/data/com.termux/files/home/qampus-app/src/Profile/Profile.js",[],"/data/data/com.termux/files/home/qampus-app/src/Chats/Chats.js",[],"/data/data/com.termux/files/home/qampus-app/src/Chats/Contact.js",[],"/data/data/com.termux/files/home/qampus-app/src/Chats/Message.js",[],"/data/data/com.termux/files/home/qampus-app/src/Chats/ChatsBody.js",[],{"ruleId":"47","replacedBy":"48"},{"ruleId":"49","replacedBy":"50"},{"ruleId":"51",