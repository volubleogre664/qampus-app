leWarningCount":0,"usedDeprecatedRules":"46"},{"filePath":"84","messages":"85","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"86","messages":"87","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\index.js",[],["88","89"],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\App.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\reportWebVitals.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\Redux\\store.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\Redux\\features\\messagesSlice.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\ApolloProvider.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\Redux\\getSlices.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Chats\\Chats.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Chats\\Message.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Chats\\Contact.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Home\\Home.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Home\\MenuItem.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Home\\SearchResult.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Profile\\Profile.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Login\\Login.js",["90"],"import React from \"react\";\r\nimport { Button } from \"@material-ui/core\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { useMutation } from \"@apollo/react-hooks\";\r\nimport { useUserHelpers } from \"../../Redux/getSlices\";\r\nimport { useForm } from \"../../utils/hooks\";\r\nimport logo from \"../../logo.png\";\r\nimport { LOGIN_USER } from \"../../utils/graphql\";\r\nimport \"./Login.css\";\r\n\r\nfunction Login({ history }) {\r\n  const [{ path }, dispatch] = useUserHelpers();\r\n  const { onChange, onSubmit, values } = useForm(loginUser, {\r\n    studentNumber: \"\",\r\n    password: \"\",\r\n  });\r\n  // console.log(history);\r\n\r\n  const [login, { loading }] = useMutation(LOGIN_USER, {\r\n    update(_, { data: { login: userData } }) {\r\n      dispatch({ type: \"SET_USER\", payload: userData });\r\n      (path && history.push(path)) || history.goBack();\r\n    },\r\n    variables: values,\r\n    onError(err) {\r\n      console.log(err);\r\n    },\r\n  });\r\n\r\n  function loginUser() {\r\n    login();\r\n  }\r\n\r\n  return (\r\n    <div className=\"login\">\r\n      <header className=\"login__header\">\r\n        <img className=\"login__headerLogo\" src={logo} alt=\"qampus logo\" />\r\n      </header>\r\n      <div className=\"welcome__text\">\r\n        <p>Welcome to Qampus</p>\r\n      </div>\r\n      <main className=\"login__main\">\r\n        <h3 className=\"title\">Login to access full features</h3>\r\n\r\n        <form className=\"form\" onSubmit={onSubmit}>\r\n          <label htmlFor=\"studentNum\">\r\n            Student Number: <br />\r\n            <input\r\n              type=\"text\"\r\n              name=\"studentNumber\"\r\n              className=\"form__idInput\"\r\n              required\r\n              maxLength=\"10\"\r\n              value={values.studentNumber}\r\n              onChange={onChange}\r\n              id=\"studentNum\"\r\n            />\r\n          </label>\r\n\r\n          <label htmlFor=\"password\">\r\n            Password: <br />\r\n            <input\r\n              type=\"password\"\r\n              name=\"password\"\r\n              id=\"password\"\r\n              required\r\n              value={values.password}\r\n              onChange={onChange}\r\n              className=\"form__passwordInput\"\r\n            />\r\n          </label>\r\n\r\n          <div className=\"form__btns\">\r\n            <Button type=\"submit\" className=\"form__btnSubmit\">\r\n              Login\r\n            </Button>\r\n            <p>or</p>\r\n            <Link className=\"form__signupLink\" to=\"/register\">\r\n              Sign Up\r\n            </Link>\r\n          </div>\r\n        </form>\r\n      </main>\r\n\r\n      <footer className=\"login__footer\">\r\n        <span>Qampus &copy; 2020 All Rights Reserved</span>\r\n\r\n        <span className=\"login__footerSeparator\"></span>\r\n        <span>Developed by Nuclear Software (Pty) Ltd.</span>\r\n      </footer>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;\r\n","C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\HeaderMenu\\HeaderMenu.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\Redux\\features\\userSlice.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\utils\\hooks.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\utils\\AuthRoute.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\pages\\Register\\Register.js",["91"],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\src\\utils\\graphql.js",[],{"ruleId":"92","replacedBy":"93"},{"ruleId":"94","replacedBy":"95"},{"ruleId":"96","severity":1,"message":"97","line":19,"column":19,"nodeType":"98","messageId":"99","endLine":19,"endColumn":26},{"ruleId":"96","severity":1,"message":"97","line":23,"column":22,"nodeType":"98","messageId":"99","endLine":23,"endColumn":29},"no-native-reassign",["100"],"no-negated-in-lhs",["101"],"no-unused-vars","'loading' is assigned a value but never used.","Identifier","unusedVar","no-global-assign","no-unsafe-negation"]