atedRules":"62"},{"filePath":"110","messages":"111","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"112","messages":"113","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"114","usedDeprecatedRules":"62"},{"filePath":"115","messages":"116","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"117","messages":"118","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"119","messages":"120","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/index.js",[],["121","122"],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/reportWebVitals.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/ApolloProvider.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/App.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/store.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/getSlices.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/AuthRoute.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Home/Home.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Chats/Chats.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Profile/Profile.js",["123","124"],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Login/Login.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/Register.js",["125"],"import React, { useEffect } from \"react\";\nimport { useMutation } from \"@apollo/react-hooks\";\nimport { Link } from \"react-router-dom\";\nimport { Button } from \"@material-ui/core\";\n\nimport logo from \"../../logo.png\";\nimport { useForm } from \"../../utils/hooks\";\nimport { REGISTER_USER } from \"../../utils/graphql\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\n\nimport \"./Register.css\";\n\nfunction Register({ history }) {\n  const { onChange, onSubmit, values } = useForm(registerUser, {\n    studentNumber: \"\",\n    firstName: \"\",\n    lastName: \"\",\n    email: \"\",\n    password: \"\",\n    confirmPassword: \"\",\n  });\n  const [, dispatch] = useUserHelpers();\n\n  const [register] = useMutation(REGISTER_USER, {\n    update(_, { data: { register: userData } }) {\n      dispatch({\n        type: \"SET_USER\",\n        payload: userData,\n      });\n\n      history.push(\"/register/finalise\");\n    },\n    variables: values,\n    onError(err) {\n      dispatch({\n        type: \"SET_ERRORS\",\n        payload: err?.graphQLErrors[0]?.extensions?.errors,\n      });\n    },\n  });\n\n  function registerUser() {\n    register();\n  }\n\n  // This code is for testing\n  // const onSubmit = (e) => {\n  //   e.preventDefault();\n\n  //   dispatch({\n  //     type: \"SET_ERRORS\",\n  //     payload: {\n  //       name: \"Name cannot be empty\",\n  //       surname: \"surname cannot be empty\",\n  //       password: \"Password cannot be empty\",\n  //       confirmPassword: \"This should match with password\",\n  //     },\n  //   });\n  // };\n\n  useEffect(() => {\n    document.title = \"Qampus | Register Account\";\n  }, []);\n\n  return (\n    <div className=\"register\">\n      <section className=\"page_headers\">\n        <img  className=\"logo\" src={logo} alt=\"qampus app register user\" />\n        <h1 className=\"welcome_header\">Welcome</h1>\n        <hr className=\"separator\" />\n        <h2 className=\"title\">please register to access all the features</h2>\n\n      </section>\n\n      <section className=\"page_content\">\n        <div className=\"register__aside\">\n          <p className=\"list_tittle\">Why should I create an account?</p> \n          <ul class=\"tilesWrap\">\n            <li>\n              <h2>01</h2>\n              <h3>Advertise to the entire campus</h3>\n              <p>\n              You can upload your used texbooks and connect with thousands of students who are looking to buy them. When you register you can upload 2 textbooks for FREE.\n              </p>\n            </li>\n            <li>\n              <h2>02</h2>\n              <h3>Spend less on textbooks</h3>\n              <p>\n              Save yourself thousands of rands in texbooks fees by buying used texbooks from students who are on your campus.              </p>\n            </li>\n            <li>\n              <h2>03</h2>\n              <h3>Never get lost on campus</h3>\n              <p>\n              Do you have an unfamiliar class venue? Find your way around campus by using our navigation system.\n              </p>\n            </li>\n            <li>\n              <h2>04</h2>\n              <h3>Meet more interesting people</h3>\n              <p>\n              Connect with your peers who are registered on Qampus and get to know them better.\n              </p>\n            </li>\n          </ul>\n        </div>\n\n        <div className=\"register__main\">\n          <form onSubmit={onSubmit} className=\"register__mainForm\">\n          <label htmlFor=\"firstName\">\n            First Name(s): <br />\n            <input\n              type=\"text\"\n              name=\"firstName\"\n              className=\"formInput\"\n              required\n              value={values.firstName}\n              onChange={onChange}\n              id=\"firstName\"\n            />\n          </label>\n\n          <label htmlFor=\"lastName\">\n            Last Name: <br />\n            <input\n              type=\"text\"\n              name=\"lastName\"\n              className=\"formInput\"\n              required\n              value={values.lastName}\n              onChange={onChange}\n              id=\"lastName\"\n            />\n          </label>\n\n          <label htmlFor=\"email\">\n            Email Address: <br />\n            <input\n              type=\"email\"\n              name=\"email\"\n              className=\"formInput\"\n              required\n              value={values.email}\n              onChange={onChange}\n              id=\"email\"\n            />\n          </label>\n\n          <label htmlFor=\"studentNumber\">\n            Student Number: <br />\n            <input\n              type=\"text\"\n              name=\"studentNumber\"\n              className=\"formInput\"\n              required\n              maxLength=\"10\"\n              value={values.studentNumber}\n              onChange={onChange}\n              id=\"studentNumber\"\n            />\n          </label>\n\n          <label htmlFor=\"password\">\n            Password: <br />\n            <input\n              type=\"password\"\n              name=\"password\"\n              className=\"formInput\"\n              required\n              value={values.password}\n              onChange={onChange}\n              id=\"password\"\n            />\n          </label>\n\n          <label htmlFor=\"confirmPassword\">\n            Confirm password: <br />\n            <input\n              type=\"password\"\n              name=\"confirmPassword\"\n              className=\"formInput\"\n              required\n              value={values.confirmPassword}\n              onChange={onChange}\n              id=\"confirmPassword\"\n            />\n          </label>\n\n          <Button type=\"submit\">Sign up</Button>\n\n          {/* Below button for testing */}\n          {/* <Button onClick={onSubmit}>Register</Button>  */}\n        </form>\n        </div>\n       \n      </section>\n      <footer className=\"register__footer\">\n        <hr className=\"separator_footer\" />\n        <span name=\"top_footer\">Qampus &copy; 2020 | All Rights Reserved.</span>\n\n        <span className=\"register__footerSeparator\"></span>\n        <span name=\"bottom_footer\">\n          Developed by Nuclear Software (Pty) Ltd\n        </span>\n      </footer>\n    </div>\n  );\n}\n\nexport default Register;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MessageBox/MessageBox.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/userSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/messagesSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/hooks.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/graphql.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/FinaliseRegister.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/HeaderMenu/HeaderMenu.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/CropImage/CropImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/UploadCollection.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MenuItem/MenuItem.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Contact/Contact.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/booksSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/ProfileImage/ProfileImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/SearchResult/SearchResult.js",["126","127"],"import React, { useLayoutEffect, useState } from \"react\";\nimport book from \"./book.jpg\";\nimport \"./SearchResult.css\";\n\n\nvar book_description = \"book description from DB goes here\";\nvar date_uploaded = \"date from db goes here\";\n\nfunction SearchResult() {\n  const [width, setWidth] = useState(0);\n\n  // window.onresize = () =>\n  //   console.log(document.querySelector(\".triangle\").style.width);\n\n  // let mounted = true;\n  useLayoutEffect(() => {\n    setWidth(0.7 * (0.61 * window.innerWidth));\n  }, [setWidth]);\n\n  return (\n    <div className=\"searchResult\">\n      <img src={book} alt=\"book result\" className=\"searchResult__img\" />\n      <div className=\"searchResult__description\">\n        <b>ISBN:</b> 9781408046634<br />\n        <b>Title:</b> Database Principles<br />\n        <b>Module Code:</b> CSIS3714 <br />\n        <b>Author:</b> Stephen Morris, David Smith <br />\n        <b>Price:</b> R310,00 <br />\n        <b>Edition: </b>2nd <br />\n      </div>\n      <span className=\"dateContainer\">Uploaded: 17/06/2021</span>\n      <span className=\"triangle\" style={{ width: width + \"px\" }}></span>\n    </div>\n  );\n}\n\nexport default SearchResult;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Message/Message.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/getCroppedImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/Upload/Upload.js",[],{"ruleId":"128","replacedBy":"129"},{"ruleId":"130","replacedBy":"131"},{"ruleId":"132","severity":1,"message":"133","line":1,"column":10,"nodeType":"134","messageId":"135","endLine":1,"endColumn":18},{"ruleId":"132","severity":1,"message":"136","line":9,"column":20,"nodeType":"134","messageId":"135","endLine":9,"endColumn":28},{"ruleId":"132","severity":1,"message":"137","line":3,"column":10,"nodeType":"134","messageId":"135","endLine":3,"endColumn":14},{"ruleId":"132","severity":1,"message":"138","line":6,"column":5,"nodeType":"134","messageId":"135","endLine":6,"endColumn":21},{"ruleId":"132","severity":1,"message":"139","line":7,"column":5,"nodeType":"134","messageId":"135","endLine":7,"endColumn":18},"no-native-reassign",["140"],"no-negated-in-lhs",["141"],"no-unused-vars","'Redirect' is defined but never used.","Identifier","unusedVar","'dispatch' is assigned a value but never used.","'Link' is defined but never used.","'book_description' is assigned a value but never used.","'date_uploaded' is assigned a value but never used.","no-global-assign","no-unsafe-negation"]