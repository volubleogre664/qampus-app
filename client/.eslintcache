WarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"113","messages":"114","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"115","usedDeprecatedRules":"62"},{"filePath":"116","messages":"117","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"120","messages":"121","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/index.js",[],["122","123"],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/reportWebVitals.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/ApolloProvider.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/App.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/store.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/getSlices.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/AuthRoute.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Home/Home.js",["124"],"import React, { useEffect, useState } from \"react\";\n// import PersonIcon from \"../../account-home.png\";\nimport PersonIcon from \"@material-ui/icons/Person\";\nimport MenuItem from \"../../components/MenuItem/MenuItem.js\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../logo.png\";\nimport SearchResult from \"../../components/SearchResult/SearchResult\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\nimport { SearchOutlined } from \"@material-ui/icons\";\nimport \"./Home.css\";\n\n//change the background reference here\nvar ref_link = 'https://500px.com/photo/294752081/Down-by-the-lakeside-by-S-Luciano-Fredheim';\nvar ref_name = \"S. Luciano Fredheim\";\n\nfunction Home({ history }) {\n  const [results, setResults] = useState([]);\n  const [{ user }] = useUserHelpers();\n  // Toggles the results section and the menu section\n  const [displays, setDisplays] = useState({\n    menu: \"flex\",\n    results: \"none\",\n  });\n\n  // Handles click of search button\n  const handleSearchClick = (e) => {\n    e.preventDefault();\n    if (displays.menu !== \"none\") {\n      setResults([...results, 1, 1]);\n      setDisplays({ ...results, menu: \"none\", results: \"flex\" });\n    }\n  };\n\n  const handleAvatarClick = () => {\n    history.push(\"/profile\");\n  };\n\n  // Helps retturn back to the menu\n  const openMenu = () => {\n    setDisplays({ menu: \"flex\", results: \"none\" });\n    setResults([]);\n  };\n\n  useEffect(() => {\n    document.title = \"Qampus | Home\";\n  }, []);\n\n  return (\n    <div className=\"home\">\n      <div className=\"home__header\">\n       \n\n        <div className=\"home__avatar\" onClick={handleAvatarClick}>\n          <PersonIcon className=\"avatarIcon\"/>\n          <div className=\"home__avatarName\">{user?.firstName || \"Guest\"}</div>\n        </div>\n      </div>\n\n      <div className=\"home__searchSection\">\n      <div className=\"home__logo\">\n          <img className=\"home__logoImg logo\" src={logo} alt=\"qampus logo\" />\n        </div>\n        <h4 className=\"home__title\">Welcome</h4>\n        <h3 className=\"home__title2\">here you can sell your texbooks, or buy them from other students</h3>\n\n        <p className=\"home__subtitle\">Search for textbooks</p>\n\n        <form className=\"home__searchContainer\">\n          <input type=\"text\" name=\"searchBook\" className=\"home__searchInput\" placeholder=\"Type the title, ISBN or module code.\"/>\n          <button type=\"submit\" onClick={handleSearchClick}>\n            <SearchOutlined />\n          </button>\n        </form>\n      </div>\n\n      <div className=\"home__menu\" style={{ display: displays.menu }}>\n        <div className=\"home__menuItems\">\n          <Link to=\"/upload\">\n            <MenuItem\n              icon=\"upload\"\n              title=\"Upload\"\n              subtitle=\"Upload your used textbooks and sell them to other students. \"\n            />{\" \"}\n          </Link>\n\n          <Link to=\"/collection\">\n            <MenuItem\n              icon=\"collection\"\n              title=\"Book Collection\"\n              subtitle=\"Have a look at a collection of all the books that you've uploaded.\"\n            />{\" \"}\n          </Link>\n\n          <Link to=\"chats\">\n            <MenuItem\n              icon=\"chats\"\n              title=\"Chats\"\n              subtitle=\"Connect with other students who are registered on Qampus.\"\n            />{\" \"}\n          </Link>\n\n          <Link to=\"navigation\">\n            <MenuItem\n              icon=\"navigation\"\n              title=\"Navigation\"\n              subtitle=\"Find your way around campus with Qampus.\"\n            />{\" \"}\n          </Link>\n\n          <Link to=\"/setting\">\n            <MenuItem\n              icon=\"settings\"\n              title=\"Settings\"\n              subtitle=\"Change your profile preferences, etc.\"\n            />{\" \"}\n          </Link>\n        </div>\n      </div>\n\n      <div\n        className=\"home__searchResults\"\n        style={{ display: displays.results }}\n      >\n        <div className=\"heading\">\n          <h3>Search results</h3>\n          <button className=\"btnBack\" onClick={openMenu}>X{/*Close search results*/}</button>\n        </div>\n        {results?.map((_, i) => {\n          return <SearchResult key={i} />;\n        })}\n      </div>\n\n      <div className='reference'>\n        <a className=\"reference_link\" target=\"_blank\" href={ref_link}>Do you like this photo? <br/> [ by<u> {ref_name} </u>]</a>\n      </div>\n\n    </div>\n  );\n}\n\nexport default Home;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Chats/Chats.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Profile/Profile.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Login/Login.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/Register.js",["125"],"import React, { useEffect } from \"react\";\nimport { useMutation } from \"@apollo/react-hooks\";\nimport { Link } from \"react-router-dom\";\nimport { Button } from \"@material-ui/core\";\n\nimport logo from \"../../logo.png\";\nimport { useForm } from \"../../utils/hooks\";\nimport { REGISTER_USER } from \"../../utils/graphql\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\n\nimport \"./Register.css\";\n\nfunction Register({ history }) {\n  const { onChange, onSubmit, values } = useForm(registerUser, {\n    studentNumber: \"\",\n    firstName: \"\",\n    lastName: \"\",\n    email: \"\",\n    password: \"\",\n    confirmPassword: \"\",\n  });\n  const [, dispatch] = useUserHelpers();\n\n  const [register] = useMutation(REGISTER_USER, {\n    update(_, { data: { register: userData } }) {\n      dispatch({\n        type: \"SET_USER\",\n        payload: userData,\n      });\n\n      history.push(\"/register/finalise\");\n    },\n    variables: values,\n    onError(err) {\n      dispatch({\n        type: \"SET_ERRORS\",\n        payload: err?.graphQLErrors[0]?.extensions?.errors,\n      });\n    },\n  });\n\n  function registerUser() {\n    register();\n  }\n\n  // This code is for testing\n  // const onSubmit = (e) => {\n  //   e.preventDefault();\n\n  //   dispatch({\n  //     type: \"SET_ERRORS\",\n  //     payload: {\n  //       name: \"Name cannot be empty\",\n  //       surname: \"surname cannot be empty\",\n  //       password: \"Password cannot be empty\",\n  //       confirmPassword: \"This should match with password\",\n  //     },\n  //   });\n  // };\n\n  useEffect(() => {\n    document.title = \"Qampus | Register Account\";\n  }, []);\n\n  return (\n    <div className=\"register\">\n      <section className=\"page_headers\">\n        <img  className=\"logo\" src={logo} alt=\"qampus app register user\" />\n        <h1 className=\"welcome_header\">Welcome</h1>\n        <hr className=\"separator\" />\n        <h2 className=\"title\">please register to access all the features</h2>\n\n      </section>\n\n      <section className=\"page_content\">\n        <div className=\"register__aside\">\n          <p className=\"list_tittle\">Why should I create an account?</p> \n          <ul class=\"tilesWrap\">\n            <li>\n              <h2>01</h2>\n              <h3>Advertise to the entire campus</h3>\n              <p>\n              You can upload your used texbooks and connect with thousands of students who are looking to buy them. When you register you can upload 2 textbooks for FREE.\n              </p>\n            </li>\n            <li>\n              <h2>02</h2>\n              <h3>Spend less on textbooks</h3>\n              <p>\n              Save yourself thousands of rands in texbooks fees by buying used texbooks from students who are on your campus.              </p>\n            </li>\n            <li>\n              <h2>03</h2>\n              <h3>Never get lost on campus</h3>\n              <p>\n              Do you have an unfamiliar class venue? Find your way around campus by using our navigation system.\n              </p>\n            </li>\n            <li>\n              <h2>04</h2>\n              <h3>Meet more interesting people</h3>\n              <p>\n              Connect with your peers who are registered on Qampus and get to know them better.\n              </p>\n            </li>\n          </ul>\n        </div>\n\n        <div className=\"register__main\">\n          <form onSubmit={onSubmit} className=\"register__mainForm\">\n          <label htmlFor=\"firstName\">\n            First Name(s): <br />\n            <input\n              type=\"text\"\n              name=\"firstName\"\n              className=\"formInput\"\n              required\n              value={values.firstName}\n              onChange={onChange}\n              id=\"firstName\"\n            />\n          </label>\n\n          <label htmlFor=\"lastName\">\n            Last Name: <br />\n            <input\n              type=\"text\"\n              name=\"lastName\"\n              className=\"formInput\"\n              required\n              value={values.lastName}\n              onChange={onChange}\n              id=\"lastName\"\n            />\n          </label>\n\n          <label htmlFor=\"email\">\n            Email Address: <br />\n            <input\n              type=\"email\"\n              name=\"email\"\n              className=\"formInput\"\n              required\n              value={values.email}\n              onChange={onChange}\n              id=\"email\"\n            />\n          </label>\n\n          <label htmlFor=\"studentNumber\">\n            Student Number: <br />\n            <input\n              type=\"text\"\n              name=\"studentNumber\"\n              className=\"formInput\"\n              required\n              maxLength=\"10\"\n              value={values.studentNumber}\n              onChange={onChange}\n              id=\"studentNumber\"\n            />\n          </label>\n\n          <label htmlFor=\"password\">\n            Password: <br />\n            <input\n              type=\"password\"\n              name=\"password\"\n              className=\"formInput\"\n              required\n              value={values.password}\n              onChange={onChange}\n              id=\"password\"\n            />\n          </label>\n\n          <label htmlFor=\"confirmPassword\">\n            Confirm password: <br />\n            <input\n              type=\"password\"\n              name=\"confirmPassword\"\n              className=\"formInput\"\n              required\n              value={values.confirmPassword}\n              onChange={onChange}\n              id=\"confirmPassword\"\n            />\n          </label>\n\n          <Button type=\"submit\">Sign up</Button>\n\n          {/* Below button for testing */}\n          {/* <Button onClick={onSubmit}>Register</Button>  */}\n        </form>\n        </div>\n       \n      </section>\n      <footer className=\"register__footer\">\n        <hr className=\"separator_footer\" />\n        <span name=\"top_footer\">Qampus &copy; 2020 | All Rights Reserved.</span>\n\n        <span className=\"register__footerSeparator\"></span>\n        <span name=\"bottom_footer\">\n          Developed by Nuclear Software (Pty) Ltd\n        </span>\n      </footer>\n    </div>\n  );\n}\n\nexport default Register;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MessageBox/MessageBox.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/userSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/messagesSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/hooks.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/graphql.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/FinaliseRegister.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/HeaderMenu/HeaderMenu.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/CropImage/CropImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/UploadCollection.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MenuItem/MenuItem.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Contact/Contact.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/booksSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/ProfileImage/ProfileImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/SearchResult/SearchResult.js",["126","127"],"import React, { useLayoutEffect, useState } from \"react\";\nimport book from \"./book.jpg\";\nimport \"./SearchResult.css\";\n\n\nvar book_descriptio = \"book description from DB goes here\";\nvar date_uploaded = \"date from db goes here\";\n\nfunction SearchResult() {\n  const [width, setWidth] = useState(0);\n\n  // window.onresize = () =>\n  //   console.log(document.querySelector(\".triangle\").style.width);\n\n  // let mounted = true;\n  useLayoutEffect(() => {\n    setWidth(0.7 * (0.61 * window.innerWidth));\n  }, [setWidth]);\n\n  return (\n    <div className=\"searchResult\">\n      <img src={book} alt=\"book result\" className=\"searchResult__img\" />\n      <div className=\"searchResult__description\">\n        <b>ISBN:</b> 9781408046634<br />\n        <b>Title:</b> Database Principles<br />\n        <b>Module Code:</b> CSIS3714 <br />\n        <b>Author:</b> Stephen Morris, David Smith <br />\n        <b>Price:</b> R310,00 <br />\n        <b>Edition: </b>2nd <br />\n      </div>\n      <span className=\"dateContainer\">Uploaded: 17/06/2021</span>\n      <span className=\"triangle\" style={{ width: width + \"px\" }}></span>\n    </div>\n  );\n}\n\nexport default SearchResult;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Message/Message.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/getCroppedImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/Upload/Upload.js",[],{"ruleId":"128","replacedBy":"129"},{"ruleId":"130","replacedBy":"131"},{"ruleId":"132","severity":1,"message":"133","line":134,"column":9,"nodeType":"134","messageId":"135","endLine":134,"endColumn":71,"fix":"136"},{"ruleId":"137","severity":1,"message":"138","line":3,"column":10,"nodeType":"139","messageId":"140","endLine":3,"endColumn":14},{"ruleId":"137","severity":1,"message":"141","line":6,"column":5,"nodeType":"139","messageId":"140","endLine":6,"endColumn":20},{"ruleId":"137","severity":1,"message":"142","line":7,"column":5,"nodeType":"139","messageId":"140","endLine":7,"endColumn":18},"no-native-reassign",["143"],"no-negated-in-lhs",["144"],"react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","JSXOpeningElement","noTargetBlank",{"range":"145","text":"146"},"no-unused-vars","'Link' is defined but never used.","Identifier","unusedVar","'book_descriptio' is assigned a value but never used.","'date_uploaded' is assigned a value but never used.","no-global-assign","no-unsafe-negation",[4266,4266]," rel=\"noreferrer\""]