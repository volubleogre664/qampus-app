orCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"113","messages":"114","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"115","messages":"116","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"117","messages":"118","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\index.js",[],["119","120"],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\reportWebVitals.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\ApolloProvider.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\App.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\Redux\\store.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\Redux\\getSlices.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\utils\\AuthRoute.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\pages\\Home\\Home.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\pages\\Profile\\Profile.js",["121"],"import { Redirect } from \"react-router-dom\";\r\n\r\nimport ProfileImage from \"../../components/ProfileImage/ProfileImage\";\r\nimport appLogo from \"../../logo.png\";\r\nimport { useUserHelpers } from \"../../Redux/getSlices\";\r\n\r\nimport \"./Profile.css\";\r\n\r\nfunction Profile() {\r\n  const [{ user }, dispatch] = useUserHelpers();\r\n\r\n  if (!user) {\r\n    dispatch({\r\n      type: \"SET_PATH\",\r\n      payload: \"/profile\",\r\n    });\r\n    return <Redirect to=\"/login\" />;\r\n  }\r\n\r\n  return (\r\n    <div className=\"profile\">\r\n      <header className=\"finaliseReg__header\">\r\n        <h1 className=\"title\">Your Profile</h1>\r\n      </header>\r\n\r\n      <section className=\"profile__body\">\r\n        <aside className=\"profile__bodyAside\">\r\n          <ProfileImage title=\"Your Profile Picture\" />\r\n        </aside>\r\n\r\n        <main className=\"profile__bodyMain\">\r\n          <form>\r\n            <div>\r\n              <h3>Name: </h3>\r\n              <p>{user.firstName}</p>\r\n            </div>\r\n\r\n            <div>\r\n              <h3>Surname: </h3>\r\n              <p>{user.lastName}</p>\r\n            </div>\r\n\r\n            <div>\r\n              <h3>Email: </h3>\r\n              <p>{user.email}</p>\r\n            </div>\r\n\r\n            <div>\r\n              <h3>Student Number: </h3>\r\n              <p>{user.studentNumber}</p>\r\n            </div>\r\n\r\n            <label htmlFor=\"degree\">\r\n              Degree: <br />\r\n              <input\r\n                type=\"text\"\r\n                name=\"degree\"\r\n                id=\"degree\"\r\n                value={user?.degree || \"\"}\r\n                disabled\r\n                placeholder=\"BSc in IT\"\r\n              />\r\n            </label>\r\n\r\n            <label htmlFor=\"degree\">\r\n              Bio: <br />\r\n              <textarea\r\n                name=\"bio\"\r\n                id=\"bio\"\r\n                value={user?.bio || \"\"}\r\n                disabled\r\n                placeholder=\"Tell us a little about your self\"\r\n              />\r\n            </label>\r\n          </form>\r\n        </main>\r\n      </section>\r\n      {/* The page will have image on the left and The rest of the information will be on the right */}\r\n\r\n      {/* At the top it will be a logo with the just a heading saying your profile */}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Profile;\r\n","C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\pages\\Chats\\Chats.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\pages\\Login\\Login.js",["122"],"import React, { useEffect } from \"react\";\r\nimport { Button } from \"@material-ui/core\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { useMutation } from \"@apollo/react-hooks\";\r\nimport { useUserHelpers } from \"../../Redux/getSlices\";\r\nimport { useForm } from \"../../utils/hooks\";\r\nimport logo from \"../../logo.png\";\r\nimport { LOGIN_USER } from \"../../utils/graphql\";\r\nimport \"./Login.css\";\r\n\r\nfunction Login({ history }) {\r\n  const [{ path }, userDispatch] = useUserHelpers();\r\n  const { onChange, onSubmit, values } = useForm(loginUser, {\r\n    studentNumber: \"\",\r\n    password: \"\",\r\n  });\r\n  // console.log(history);\r\n\r\n  const [login, { loading }] = useMutation(LOGIN_USER, {\r\n    update(_, { data: { login: userData } }) {\r\n      userDispatch({ type: \"SET_USER\", payload: userData });\r\n      path !== \"\" ? history.push(path) : history.goBack();\r\n    },\r\n    variables: values,\r\n    onError(err) {\r\n      console.log(err);\r\n      userDispatch({\r\n        type: \"SET_ERRORS\",\r\n        payload: err.graphQLErrors[0].extensions?.errors,\r\n      });\r\n    },\r\n  });\r\n\r\n  function loginUser() {\r\n    login();\r\n  }\r\n\r\n  useEffect(() => {\r\n    document.title = \"Qampus | Login to Account\";\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"login\">\r\n      <header className=\"login__header\">\r\n        <img className=\"login__headerLogo\" src={logo} alt=\"qampus logo\" />\r\n      </header>\r\n      <div className=\"welcome__text\">\r\n        <p>Welcome to Qampus</p>\r\n      </div>\r\n      <main className=\"login__main\">\r\n        <h3 className=\"title\">Login to access full features</h3>\r\n\r\n        <form className=\"form\" onSubmit={onSubmit}>\r\n          <label htmlFor=\"studentNum\">\r\n            Student Number: <br />\r\n            <input\r\n              type=\"text\"\r\n              name=\"studentNumber\"\r\n              className=\"form__idInput\"\r\n              required\r\n              maxLength=\"10\"\r\n              value={values.studentNumber}\r\n              onChange={onChange}\r\n              id=\"studentNum\"\r\n            />\r\n          </label>\r\n\r\n          <label htmlFor=\"password\">\r\n            Password: <br />\r\n            <input\r\n              type=\"password\"\r\n              name=\"password\"\r\n              id=\"password\"\r\n              required\r\n              value={values.password}\r\n              onChange={onChange}\r\n              className=\"form__passwordInput\"\r\n            />\r\n          </label>\r\n\r\n          <div className=\"form__btns\">\r\n            <Button type=\"submit\" className=\"form__btnSubmit\">\r\n              Login\r\n            </Button>\r\n            <p>or</p>\r\n            <Link className=\"form__signupLink\" to=\"/register\">\r\n              Sign Up\r\n            </Link>\r\n          </div>\r\n        </form>\r\n      </main>\r\n\r\n      <footer className=\"login__footer\">\r\n        <span>Qampus &copy; 2020 All Rights Reserved</span>\r\n\r\n        <span className=\"login__footerSeparator\"></span>\r\n        <span>Developed by Nuclear Software (Pty) Ltd.</span>\r\n      </footer>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;\r\n","C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\pages\\Register\\Register.js",["123"],"import React, { useEffect } from \"react\";\r\nimport { useMutation } from \"@apollo/react-hooks\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { Button } from \"@material-ui/core\";\r\n\r\nimport logo from \"../../logo.png\";\r\nimport { useForm } from \"../../utils/hooks\";\r\nimport { REGISTER_USER } from \"../../utils/graphql\";\r\nimport { useUserHelpers } from \"../../Redux/getSlices\";\r\n\r\nimport \"./Register.css\";\r\n\r\nfunction Register({ history }) {\r\n  const { onChange, onSubmit, values } = useForm(registerUser, {\r\n    studentNumber: \"\",\r\n    firstName: \"\",\r\n    lastName: \"\",\r\n    email: \"\",\r\n    password: \"\",\r\n    confirmPassword: \"\",\r\n  });\r\n  const [, dispatch] = useUserHelpers();\r\n\r\n  const [register, { loading }] = useMutation(REGISTER_USER, {\r\n    update(_, { data: { register: userData } }) {\r\n      dispatch({\r\n        type: \"SET_USER\",\r\n        payload: userData,\r\n      });\r\n\r\n      history.push(\"/register/finalise\");\r\n    },\r\n    variables: values,\r\n    onError(err) {\r\n      dispatch({\r\n        type: \"SET_ERRORS\",\r\n        payload: err?.graphQLErrors[0]?.extensions?.errors,\r\n      });\r\n    },\r\n  });\r\n\r\n  function registerUser() {\r\n    register();\r\n  }\r\n\r\n  // This code is for testing\r\n  // const onSubmit = (e) => {\r\n  //   e.preventDefault();\r\n\r\n  //   dispatch({\r\n  //     type: \"SET_ERRORS\",\r\n  //     payload: {\r\n  //       name: \"Name cannot be empty\",\r\n  //       surname: \"surname cannot be empty\",\r\n  //       password: \"Password cannot be empty\",\r\n  //       confirmPassword: \"This should match with password\",\r\n  //     },\r\n  //   });\r\n  // };\r\n\r\n  useEffect(() => {\r\n    document.title = \"Qampus | Register Account\";\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"register\">\r\n      <h1 className=\"title\">Welcome to Qampus</h1>\r\n      <aside className=\"register__aside\">\r\n        <img src={logo} alt=\"qampus app register user\" />\r\n        <h1>Connect with other students</h1>\r\n        <h1>Have others come to you to buy books</h1>\r\n        <h1>Easily buy books from other students</h1>\r\n        <h1>Find your way around your campus</h1>\r\n        <h1>\r\n          Create Your Account Now{\" \"}\r\n          <span role=\"img\" aria-label=\"right pointing finger\">\r\n            👉\r\n          </span>{\" \"}\r\n        </h1>\r\n        <p>\r\n          Already have an account? <Link to=\"login\">Login</Link>\r\n        </p>\r\n      </aside>\r\n\r\n      <main className=\"register__main\">\r\n        <h4 className=\"subtitle\">Sign up for more features</h4>\r\n\r\n        <form onSubmit={onSubmit} className=\"register__mainForm\">\r\n          <label htmlFor=\"firstName\">\r\n            First Name(s): <br />\r\n            <input\r\n              type=\"text\"\r\n              name=\"firstName\"\r\n              className=\"formInput\"\r\n              required\r\n              value={values.firstName}\r\n              onChange={onChange}\r\n              id=\"firstName\"\r\n            />\r\n          </label>\r\n\r\n          <label htmlFor=\"lastName\">\r\n            Last Name: <br />\r\n            <input\r\n              type=\"text\"\r\n              name=\"lastName\"\r\n              className=\"formInput\"\r\n              required\r\n              value={values.lastName}\r\n              onChange={onChange}\r\n              id=\"lastName\"\r\n            />\r\n          </label>\r\n\r\n          <label htmlFor=\"email\">\r\n            Email Address: <br />\r\n            <input\r\n              type=\"email\"\r\n              name=\"email\"\r\n              className=\"formInput\"\r\n              required\r\n              value={values.email}\r\n              onChange={onChange}\r\n              id=\"email\"\r\n            />\r\n          </label>\r\n\r\n          <label htmlFor=\"studentNumber\">\r\n            Student Number: <br />\r\n            <input\r\n              type=\"text\"\r\n              name=\"studentNumber\"\r\n              className=\"formInput\"\r\n              required\r\n              maxLength=\"10\"\r\n              value={values.studentNumber}\r\n              onChange={onChange}\r\n              id=\"studentNumber\"\r\n            />\r\n          </label>\r\n\r\n          <label htmlFor=\"password\">\r\n            Password: <br />\r\n            <input\r\n              type=\"password\"\r\n              name=\"password\"\r\n              className=\"formInput\"\r\n              required\r\n              value={values.password}\r\n              onChange={onChange}\r\n              id=\"password\"\r\n            />\r\n          </label>\r\n\r\n          <label htmlFor=\"confirmPassword\">\r\n            Confirm password: <br />\r\n            <input\r\n              type=\"password\"\r\n              name=\"confirmPassword\"\r\n              className=\"formInput\"\r\n              required\r\n              value={values.confirmPassword}\r\n              onChange={onChange}\r\n              id=\"confirmPassword\"\r\n            />\r\n          </label>\r\n\r\n          <Button type=\"submit\">Register</Button>\r\n\r\n          {/* Below button for testing */}\r\n          {/* <Button onClick={onSubmit}>Register</Button>  */}\r\n        </form>\r\n      </main>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Register;\r\n","C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\MessageBox\\MessageBox.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\Redux\\features\\messagesSlice.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\Redux\\features\\userSlice.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\utils\\hooks.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\utils\\graphql.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\pages\\Register\\FinaliseRegister.js",["124"],"import { useEffect } from \"react\";\r\nimport { useMutation } from \"@apollo/react-hooks\";\r\nimport { Button } from \"@material-ui/core\";\r\n\r\nimport { useUserHelpers } from \"../../Redux/getSlices\";\r\nimport { REGISTER_USER } from \"../../utils/graphql\";\r\nimport { useForm } from \"../../utils/hooks\";\r\n\r\nimport appLogo from \"../../logo.png\";\r\nimport \"./FinaliseRegister.css\";\r\nimport ProfileImage from \"../../components/ProfileImage/ProfileImage\";\r\n\r\nfunction CompleteRegistration({ history }) {\r\n  const [{ path }] = useUserHelpers();\r\n\r\n  const { onChange, onSubmit, values } = useForm(updateUser, {\r\n    profile: \"\",\r\n    degree: \"\",\r\n    bio: \"\",\r\n  });\r\n\r\n  const [updateProfile, { loading }] = useMutation(REGISTER_USER, {\r\n    variables: values,\r\n    update(_, { data: { success } }) {\r\n      if (success) {\r\n        console.log(success);\r\n      }\r\n    },\r\n    onError(err) {\r\n      console.log(err);\r\n    },\r\n  });\r\n\r\n  const finishLaterClick = () => {\r\n    (path && history.push(path)) || history.push(\"/\");\r\n  };\r\n\r\n  function updateUser() {\r\n    updateProfile();\r\n  }\r\n\r\n  useEffect(() => {\r\n    document.title = \"Qampus | Finish Signing Up\";\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"finaliseReg\">\r\n      <header className=\"finaliseReg__header\">\r\n        <img cclassName=\"logo\" src={appLogo} alt=\"campus app logo\" />\r\n        <h1 className=\"title\">Finish setting up your profile</h1>\r\n      </header>\r\n\r\n      <section className=\"finaliseReg__body\">\r\n        <aside className=\"finaliseReg__bodyAside\">\r\n          <ProfileImage title=\"Upload Profile Image\" />\r\n        </aside>\r\n\r\n        <main className=\"finaliseReg__bodyMain\">\r\n          <h1>More information about you: </h1>\r\n          <form onSubmit={onSubmit}>\r\n            <label htmlFor=\"degree\">\r\n              Degree: <br />\r\n              <input\r\n                type=\"text\"\r\n                name=\"degree\"\r\n                className=\"formInput\"\r\n                placeholder=\"BSc in IT\"\r\n                value={values.degree}\r\n                onChange={onChange}\r\n                id=\"degree\"\r\n              />\r\n            </label>\r\n\r\n            <label htmlFor=\"bio\">\r\n              Bio: <br />\r\n              <textarea\r\n                name=\"bio\"\r\n                id=\"bio\"\r\n                className=\"formInput\"\r\n                placeholder=\"Tell us a little about you...\"\r\n              />\r\n            </label>\r\n\r\n            <Button type=\"submit\" className=\"formSubmit\">\r\n              Finish\r\n            </Button>\r\n          </form>\r\n        </main>\r\n\r\n        <footer>\r\n          <Button onClick={finishLaterClick} className=\"btnSkip\">\r\n            Finish later\r\n          </Button>\r\n        </footer>\r\n      </section>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default CompleteRegistration;\r\n","C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\CropImage\\CropImage.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\utils\\getCroppedImage.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\ProfileImage\\ProfileImage.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\Message\\Message.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\Contact\\Contact.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\MenuItem\\MenuItem.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\SearchResult\\SearchResult.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\components\\HeaderMenu\\HeaderMenu.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\qampus-app\\client\\src\\pages\\Upload_Collection\\UploadCollection.js",[],"C:\\Users\\User\\Desktop\\qampus-app-backend\\