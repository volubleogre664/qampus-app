h":"110","messages":"111","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"112","messages":"113","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"114","messages":"115","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"116","messages":"117","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"120","messages":"121","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"122","usedDeprecatedRules":"70"},{"filePath":"123","messages":"124","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"125"},{"filePath":"126","messages":"127","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"128","messages":"129","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"130","messages":"131","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"132","messages":"133","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"134","messages":"135","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"136","messages":"137","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"70"},{"filePath":"138","messages":"139","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/index.js",[],["140","141"],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/reportWebVitals.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/ApolloProvider.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/App.js",["142","143"],"import { BrowserRouter as Router, Switch, Route } from \"react-router-dom\";\nimport firebase from \"firebase/app\";\n\nimport Home from \"./pages/Home/Home.js\";\nimport Chats from \"./pages/Chats/Chats.js\";\nimport Profile from \"./pages/Profile/Profile.js\";\nimport HeaderMenu from \"./components/HeaderMenu/HeaderMenu.js\";\nimport FinaliseRegister from \"./pages/Register/FinaliseRegister.js\";\nimport Login from \"./pages/Login/Login.js\";\nimport Register from \"./pages/Register/Register.js\";\nimport UploadCollection from \"./pages/Upload_Collection/UploadCollection.js\";\nimport AuthRoute from \"./utils/AuthRoute.js\";\n\nimport MessageBox from \"./components/MessageBox/MessageBox.js\";\nimport CropImage from \"./components/CropImage/CropImage.js\";\n\nimport { useUserHelpers } from \"./Redux/getSlices.js\";\nimport { firebaseConfig } from \"./config.js\";\n\nimport \"./App.css\";\nimport Collection from \"./pages/Collection/Collection.js\";\nimport \"firebase/storage\";\n\nfirebase.initializeApp(firebaseConfig);\n\nfunction App() {\n  const [{ errors, imgCrop }] = useUserHelpers();\n\n  return (\n    <div className=\"app\">\n      <Router>\n        {/* <MessageBox errors={errors} /> */}\n        {imgCrop.imgSrc && <CropImage />}\n        <Switch>\n          <Route exact path=\"/\" component={Home} />\n          {/* AuthRoute checks if someone is logged in and redirects to home if they are logged in */}\n          {/* No one will open login, register and finalise register without loggin out */}\n          <AuthRoute exact path=\"/login\" component={Login} />\n          <AuthRoute exact path=\"/register\" component={Register} />\n          <AuthRoute\n            exact\n            path=\"/register/finalise\"\n            component={FinaliseRegister}\n          />\n          <Route exact path=\"/profile\">\n            <HeaderMenu />\n            <Profile />\n          </Route>\n          <Route exact path=\"/chats\">\n            <HeaderMenu />\n            <Chats />\n          </Route>\n          <Route exact path=\"/upload\">\n            <HeaderMenu />\n            <UploadCollection />\n          </Route>\n          <Route exact path=\"/collection\">\n            <HeaderMenu />\n            <Collection/>\n          </Route>\n        </Switch>\n      </Router>\n    </div>\n  );\n}\n\nexport default App;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/store.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/getSlices.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/AuthRoute.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Home/Home.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Chats/Chats.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Profile/Profile.js",["144","145"],"import { GoVerified } from \"react-icons/go\";\nimport { Redirect } from \"react-router-dom\";\n\nimport ProfileImage from \"../../components/ProfileImage/ProfileImage\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\n\nimport \"./Profile.css\";\n\nfunction Profile() {\n  const [{ user }, dispatch] = useUserHelpers();\n\n  if (!user) {\n    dispatch({\n      type: \"SET_PATH\",\n      payload: \"/profile\",\n    });\n    return <Redirect to=\"/login\" />;\n  }\n\n  return (\n    <div className=\"profile\">\n      <header className=\"profile_header\">\n        <h1 className=\"title\">Your Profile</h1>\n      </header>\n\n      <section className=\"profile__body\">\n        <aside className=\"profile__bodyAside\">\n          <ProfileImage title=\"Your Profile Picture\" />\n        </aside>\n\n        <main className=\"profile__bodyMain\">\n          <div className=\"nameDiv\">\n            <p className=\"name\">\n              {user?.firstName || \"Nkosingiphile \"}{\" \"}\n              {user?.lastName || \"Mkwanazi\"}\n            </p>{\" \"}\n            <GoVerified id=\"ico\" />\n            <hr className=\"separator\" />\n          </div>\n\n          <form>\n            <label htmlFor=\"degree\">\n              <h3>Student number:</h3>\n              <input\n                className=\"textBox\"\n                type=\"email\"\n                name=\"studentNo\"\n                id=\"textbox\"\n                disabled\n                readOnly\n                value={user?.studentNumber || \"2017049467\"}\n              />\n            </label>\n            <label htmlFor=\"degree\">\n              <h3>Email:</h3>\n              <input\n                className=\"textBox\"\n                type=\"email\"\n                name=\"email\"\n                id=\"textbox\"\n                readOnly\n                value={user?.email || \"email.email.com\"}\n              />\n            </label>\n            <label htmlFor=\"degree\">\n              <h3>Field of study:</h3>\n              <input\n                className=\"textBox\"\n                type=\"text\"\n                name=\"degree\"\n                id=\"textbox\"\n                readOnly\n                value={user?.degree || \"Computer Information Systems\"}\n              />\n            </label>\n\n            <label htmlFor=\"degree\">\n              <h3>Bio:</h3>\n              <textarea\n                className=\"bioBox\"\n                name=\"bio\"\n                id=\"bio\"\n                readOnly\n                value={user?.bio || \"Hello there...\"}\n              />\n            </label>\n          </form>\n        </main>\n      </section>\n      {/* The page will have image on the left and The rest of the information will be on the right */}\n\n      {/* At the top it will be a logo with the just a heading saying your profile */}\n    </div>\n  );\n}\n\nexport default Profile;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Login/Login.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/Register.js",["146"],"import { useEffect } from \"react\";\nimport { useMutation } from \"@apollo/react-hooks\";\nimport { Button } from \"@material-ui/core\";\n// import { Link } from \"react-router-dom\";\n\nimport Loader from \"../../components/Loader/Loader\";\n\nimport { useForm } from \"../../utils/hooks\";\nimport { REGISTER_USER } from \"../../utils/graphql\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\n\nimport logo from \"../../logo.png\";\n\nimport \"./Register.css\";\n\nfunction Register({ history }) {\n  const { onChange, onSubmit, values } = useForm(registerUser, {\n    studentNumber: \"\",\n    firstName: \"\",\n    lastName: \"\",\n    email: \"\",\n    password: \"\",\n    confirmPassword: \"\",\n  });\n  const [, dispatch] = useUserHelpers();\n\n  const [register, { loading }] = useMutation(REGISTER_USER, {\n    update(_, { data: { register: userData } }) {\n      dispatch({\n        type: \"SET_USER\",\n        payload: userData,\n      });\n\n      history.push(\"/register/finalise\");\n    },\n    variables: values,\n    onError(err) {\n      dispatch({\n        type: \"SET_ERRORS\",\n        payload: err?.graphQLErrors[0]?.extensions?.errors,\n      });\n    },\n  });\n\n  function registerUser() {\n    register();\n  }\n\n  // This code is for testing\n\n  // const onSubmit = (e) => {\n  //   e.preventDefault();\n\n  //   dispatch({\n  //     type: \"SET_ERRORS\",\n  //     payload: {\n  //       name: \"Name cannot be empty\",\n  //       surname: \"surname cannot be empty\",\n  //       password: \"Password cannot be empty\",\n  //       confirmPassword: \"This should match with password\",\n  //     },\n  //   });\n  // };\n\n  useEffect(() => {\n    document.title = \"Qampus | Register Account\";\n  }, []);\n\n  return (\n    <div className=\"register\">\n      {loading && <Loader message=\"Creating account\" />}\n      <section className=\"page_headers\">\n        <img className=\"logo\" src={logo} alt=\"qampus app register user\" />\n        <h1 className=\"welcome_header\">Welcome</h1>\n        <hr className=\"separator\" />\n        <h2 className=\"title\">please register to access all the features</h2>\n      </section>\n\n      <section className=\"page_content\">\n        <div className=\"register__aside\">\n          <p className=\"list_tittle\">Why should I create an account?</p>\n          <ul className=\"tilesWrap\">\n            <li>\n              <h2>01</h2>\n              <h3>Advertise to the entire campus</h3>\n              <p>\n                You can upload your used texbooks and connect with thousands of\n                students who are looking to buy them. When you register you can\n                upload 2 textbooks for FREE.\n              </p>\n            </li>\n            <li>\n              <h2>02</h2>\n              <h3>Spend less on textbooks</h3>\n              <p>\n                Save yourself thousands of rands in texbooks fees by buying used\n                texbooks from students who are on your campus.{\" \"}\n              </p>\n            </li>\n            <li>\n              <h2>03</h2>\n              <h3>Never get lost on campus</h3>\n              <p>\n                Do you have an unfamiliar class venue? Find your way around\n                campus by using our navigation system.\n              </p>\n            </li>\n            <li>\n              <h2>04</h2>\n              <h3>Meet more interesting people</h3>\n              <p>\n                Connect with your peers who are registered on Qampus and get to\n                know them better.\n              </p>\n            </li>\n          </ul>\n        </div>\n\n        <div className=\"register__main\">\n          <form onSubmit={onSubmit} className=\"register__mainForm\">\n            <label htmlFor=\"firstName\">\n              First Name(s): <br />\n              <input\n                type=\"text\"\n                name=\"firstName\"\n                className=\"formInput\"\n                required\n                value={values.firstName}\n                onChange={onChange}\n                id=\"firstName\"\n              />\n            </label>\n\n            <label htmlFor=\"lastName\">\n              Last Name: <br />\n              <input\n                type=\"text\"\n                name=\"lastName\"\n                className=\"formInput\"\n                required\n                value={values.lastName}\n                onChange={onChange}\n                id=\"lastName\"\n              />\n            </label>\n\n            <label htmlFor=\"email\">\n              Email Address: <br />\n              <input\n                type=\"email\"\n                name=\"email\"\n                className=\"formInput\"\n                required\n                value={values.email}\n                onChange={onChange}\n                id=\"email\"\n              />\n            </label>\n\n            <label htmlFor=\"studentNumber\">\n              Student Number: <br />\n              <input\n                type=\"text\"\n                name=\"studentNumber\"\n                className=\"formInput\"\n                required\n                maxLength=\"10\"\n                value={values.studentNumber}\n                onChange={onChange}\n                id=\"studentNumber\"\n              />\n            </label>\n\n            <label htmlFor=\"password\">\n              Password: <br />\n              <input\n                type=\"password\"\n                name=\"password\"\n                className=\"formInput\"\n                required\n                value={values.password}\n                onChange={onChange}\n                id=\"password\"\n              />\n            </label>\n\n            <label htmlFor=\"confirmPassword\">\n              Confirm password: <br />\n              <input\n                type=\"password\"\n                name=\"confirmPassword\"\n                className=\"formInput\"\n                required\n                value={values.confirmPassword}\n                onChange={onChange}\n                id=\"confirmPassword\"\n              />\n            </label>\n\n            <Button type=\"submit\">Sign up</Button>\n\n            {/* Below button for testing */}\n            {/* <Button onClick={onSubmit}>Register</Button>  */}\n          </form>\n        </div>\n      </section>\n      <footer className=\"register__footer\">\n        <hr className=\"separator_footer\" />\n        <span name=\"top_footer\">Qampus &copy; 2020 | All Rights Reserved.</span>\n\n        <span className=\"register__footerSeparator\"></span>\n        <span name=\"bottom_footer\">\n          Developed by Nuclear Software (Pty) Ltd\n        </span>\n      </footer>\n    </div>\n  );\n}\n\nexport default Register;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MessageBox/MessageBox.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/userSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/messagesSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/hooks.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/graphql.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/FinaliseRegister.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/HeaderMenu/HeaderMenu.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/UploadCollection.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/CropImage/CropImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MenuItem/MenuItem.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Contact/Contact.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/booksSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/SearchResult/SearchResult.js",["147","148"],"import { useLayoutEffect, useState } from \"react\";\n\nimport bookImg from \"./book.jpg\";\n\nimport \"./SearchResult.css\";\n\n// var book_description = \"book description from DB goes here\";\n// var date_uploaded = \"date from db goes here\";\n\nfunction SearchResult({ book, history }) {\n  const [width, setWidth] = useState(0);\n\n  const handleBookClick = () => {\n    history.push(\"/chats?user=\" + book?.bookOwner);\n  };\n\n  useLayoutEffect(() => {\n    setWidth(0.7 * (0.61 * window.innerWidth));\n  }, [setWidth]);\n\n  return (\n    <div className=\"searchResult\" onClick={handleBookClick}>\n      <img\n        src={book?.frontCover || bookImg}\n        alt=\"book result\"\n        className=\"searchResult__img\"\n      />\n      <div className=\"searchResult__description\">\n        <b>ISBN:</b> {book?.isbn || \"9781408046634\"}\n        <br />\n        <b>Title:</b> {book?.title || \"Database Principles\"}\n        <br />\n        <b>Author:</b> {book?.authors || \"Stephen Morris, David Smith\"} <br />\n        <b>Price:</b> {`R${book?.price || \"310,00\"}`} <br />\n      </div>\n      <span className=\"dateContainer\">Uploaded: 17/06/2021</span>\n      <span className=\"triangle\" style={{ width: width + \"px\" }}></span>\n    </div>\n  );\n}\n\nexport default SearchResult;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/getCroppedImage.js",[],["149","150"],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/ProfileImage/ProfileImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Message/Message.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/Upload/Upload.js",[],"/home/mphile/D