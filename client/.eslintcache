ntact/Contact.js":"23","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/booksSlice.js":"24","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/SearchResult/SearchResult.js":"25","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/getCroppedImage.js":"26","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/ProfileImage/ProfileImage.js":"27","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Message/Message.js":"28","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/Upload/Upload.js":"29","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/Collection/Collection.js":"30"},{"size":451,"mtime":1620918261449,"results":"31","hashOfConfig":"32"},{"size":362,"mtime":1617613868979,"results":"33","hashOfConfig":"32"},{"size":863,"mtime":1620918261413,"results":"34","hashOfConfig":"32"},{"size":1933,"mtime":1620957833763,"results":"35","hashOfConfig":"32"},{"size":264,"mtime":1620918261417,"results":"36","hashOfConfig":"32"},{"size":2418,"mtime":1620918261417,"results":"37","hashOfConfig":"32"},{"size":376,"mtime":1617613868979,"results":"38","hashOfConfig":"32"},{"size":4345,"mtime":1620918261457,"results":"39","hashOfConfig":"32"},{"size":4586,"mtime":1620956923001,"results":"40","hashOfConfig":"32"},{"size":2615,"mtime":1620956613210,"results":"41","hashOfConfig":"32"},{"size":3341,"mtime":1620918261461,"results":"42","hashOfConfig":"32"},{"size":6070,"mtime":1620918261501,"results":"43","hashOfConfig":"32"},{"size":1071,"mtime":1620918261445,"results":"44","hashOfConfig":"32"},{"size":1073,"mtime":1620774625510,"results":"45","hashOfConfig":"32"},{"size":429,"mtime":1617613868971,"results":"46","hashOfConfig":"32"},{"size":377,"mtime":1617613868979,"results":"47","hashOfConfig":"32"},{"size":945,"mtime":1617613868979,"results":"48","hashOfConfig":"32"},{"size":2656,"mtime":1620918261493,"results":"49","hashOfConfig":"32"},{"si