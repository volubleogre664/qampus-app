ssages":"81","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"82","usedDeprecatedRules":"64"},{"filePath":"83","messages":"84","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"85","usedDeprecatedRules":"64"},{"filePath":"86","messages":"87","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"88","messages":"89","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"90","usedDeprecatedRules":"64"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"97","messages":"98","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"99","messages":"100","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"103","messages":"104","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"105","messages":"106","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"113","messages":"114","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"115","messages":"116","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"117","usedDeprecatedRules":"64"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"120","messages":"121","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"122","messages":"123","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"124","messages":"125","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"126","messages":"127","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/index.js",[],["128","129"],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/reportWebVitals.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/ApolloProvider.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/App.js",["130"],"import React from \"react\";\nimport { BrowserRouter as Router, Switch, Route } from \"react-router-dom\";\n\nimport Home from \"./pages/Home/Home.js\";\nimport Chats from \"./pages/Chats/Chats.js\";\nimport Profile from \"./pages/Profile/Profile.js\";\nimport HeaderMenu from \"./components/HeaderMenu/HeaderMenu.js\";\nimport FinaliseRegister from \"./pages/Register/FinaliseRegister.js\";\nimport Login from \"./pages/Login/Login.js\";\nimport Register from \"./pages/Register/Register.js\";\nimport AuthRoute from \"./utils/AuthRoute.js\";\nimport MessageBox from \"./components/MessageBox/MessageBox.js\";\n\nimport { useUserHelpers } from \"./Redux/getSlices.js\";\n\nimport \"./App.css\";\nimport CropImage from \"./components/CropImage/CropImage.js\";\nimport UploadCollection from \"./pages/Upload_Collection/UploadCollection.js\";\nimport Collection from \"./pages/Upload_Collection/Collection/Collection.js\";\n\nfunction App() {\n  const [{ errors, imgCrop }] = useUserHelpers();\n\n  return (\n    <div className=\"app\">\n      <Router>\n        <MessageBox errors={errors} />\n        {imgCrop.imgSrc && <CropImage />}\n        <Switch>\n          <Route exact path=\"/\" component={Home} />\n          <AuthRoute exact path=\"/login\" component={Login} />\n          <AuthRoute exact path=\"/register\" component={Register} />\n          <AuthRoute\n            exact\n            path=\"/register/finalise\"\n            component={FinaliseRegister}\n          />\n          <Route exact path=\"/profile\">\n            <HeaderMenu />\n            <Profile />\n          </Route>\n          <Route exact path=\"/chats\">\n            <HeaderMenu />\n            <Chats />\n          </Route>\n          <Route exact path=\"/upload\">\n            <HeaderMenu />\n            <UploadCollection />\n          </Route>\n          <Route exact path=\"/collection\">\n            <HeaderMenu />\n            {/* <Collection/> */}\n          </Route>\n        </Switch>\n      </Router>\n    </div>\n  );\n}\n\nexport default App;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/store.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/getSlices.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/AuthRoute.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Home/Home.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Chats/Chats.js",["131","132"],"import React, { useState, useEffect, useLayoutEffect } from \"react\";\nimport ArrowBackIosIcon from \"@material-ui/icons/ArrowBackIos\";\nimport ArrowForwardIosIcon from \"@material-ui/icons/ArrowForwardIos\";\nimport SearchIcon from \"@material-ui/icons/Search\";\nimport PersonIcon from \"@material-ui/icons/Person\";\nimport { Link, Redirect } from \"react-router-dom\";\nimport Contact from \"../../components/Contact/Contact.js\";\nimport Message from \"../../components/Message/Message\";\nimport { useMessagesHelpers, useUserHelpers } from \"../../Redux/getSlices.js\";\nimport \"./Chats.css\";\n\nfunction Chats() {\n  const [textMsg, setMsg] = useState(\"\");\n  const [height, setHeight] = useState(0); //Height given to the chats main and sidebar\n  const [windowHeight, setWindowHeigt] = useState(window.innerHeight); //Keeps track of screen height\n  const [messages, messageDispatch] = useMessagesHelpers();\n  const [{ user }, userDispatch] = useUserHelpers();\n\n  window.onresize = () => setWindowHeigt(window.innerHeight); //keeps track of changes in screen height\n\n  const handleChange = (e) => setMsg(e.target.value);\n\n  const showMsg = (e) => {\n    e.preventDefault();\n    console.log(e.preventDefault());\n\n    const regex = / /gi;\n    if (textMsg === \"\" || textMsg.replace(regex, \"\") === \"\") return;\n\n    messageDispatch({\n      payload: {\n        text: textMsg,\n        time: new Date().toLocaleTimeString(),\n        sent: false,\n      },\n    });\n    setMsg(\"\");\n  };\n\n  const closeChats = () => {\n    document.querySelector(\".chats__main\").classList.toggle(\"opening\");\n    document.querySelector(\".chats__main\").classList.toggle(\"closing\");\n\n    const chatsSidebar = document.querySelector(\".chats__sidebar\");\n    chatsSidebar.classList.toggle(\"fadeOut\");\n    chatsSidebar.classList.toggle(\"fadeIn\");\n  };\n\n  useLayoutEffect(() => {\n    const header = document.querySelector(\".app > .header\");\n\n    setHeight(windowHeight - header.clientHeight - 15);\n  }, [setHeight, windowHeight]);\n\n  useEffect(() => {\n    document.title = \"Qampus | Chats\";\n  }, []);\n\n  // if (!user) {\n  //   userDispatch({\n  //     type: \"SET_PATH\",\n  //     payload: \"/chats\",\n  //   });\n  //   return <Redirect to=\"/login\" />;\n  // }\n\n  return (\n    <div className=\"chats\">\n      <div className=\"chats__sidebar\" style={{ height: height + \"px\" }}>\n        <div className=\"chats__sidebarHeader\">\n          <h2 className=\"title\">Chats {\" | \" + user?.firstName || \"\"}</h2>\n\n          <span className=\"icon__container\">\n            <Link className=\"icon__containerLink\" to=\"/\">\n              <ArrowBackIosIcon />\n            </Link>\n          </span>\n        </div>\n\n        <div className=\"chats__sidebarBody\">\n          <div className=\"search__container\">\n            <input className=\"search__input\" placeholder=\"\" />\n            <SearchIcon />\n          </div>\n\n          <div className=\"contactSection\">\n            <Contact name=\"James King\" />\n            <Contact name=\"Mason Monroe\" />\n          </div>\n        </div>\n\n        <div className=\"chats__sidebarFooter\">\n          <span className=\"text\">Find a study buddy</span>\n          <ArrowForwardIosIcon />\n        </div>\n      </div>\n\n      <div className=\"chats__main\" style={{ height: height + \"px\" }}>\n        <div className=\"chats__mainHeader\">\n          <div className=\"left\" onClick={closeChats}>\n            <span className=\"iconContainer\">\n              <PersonIcon />\n            </span>\n            <span className=\"name\">Elon</span>\n          </div>\n\n          <div className=\"right\">\n            <label className=\"online__status\">Offline</label>\n            <label className=\"last__seen\">Last seen: Now</label>\n          </div>\n        </div>\n\n        <div className=\"chats__mainBody\">\n          <Message messages={messages} />\n        </div>\n\n        <div className=\"chats__mainFooter\">\n          <form onSubmit={showMsg}>\n            <button className=\"btnAttach\">\n              <i className=\"fas fa-paperclip\"></i>\n            </button>\n\n            <button className=\"btnEmoji\">\n              <i className=\"fas fa-grin\"></i>\n            </button>\n\n            <input\n              placeholder=\"\"\n              className=\"sendMsgInput\"\n              onChange={handleChange}\n              value={textMsg}\n            />\n\n            <button className=\"btnSend\" type=\"submit\">\n              <i className=\"fas fa-paper-plane\"></i>\n            </button>\n\n            <button className=\"btnRecord\">\n              <i className=\"fas fa-microphone\"></i>\n            </button>\n          </form>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport default Chats;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Profile/Profile.js",["133","134"],"import { Redirect } from \"react-router-dom\";\n\nimport ProfileImage from \"../../components/ProfileImage/ProfileImage\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\nimport { GoVerified } from \"react-icons/go\"\nimport \"./Profile.css\";\n\nfunction Profile() {\n  const [{ user }, dispatch] = useUserHelpers();\n\n  // if (!user) {\n  //   dispatch({\n  //     type: \"SET_PATH\",\n  //     payload: \"/profile\",\n  //   });\n  //   return <Redirect to=\"/login\" />;\n  // }\n\n  return (\n    <div className=\"profile\">\n      <header className=\"profile_header\">\n        <h1 className=\"title\">Your Profile</h1>\n      </header>\n\n      <section className=\"profile__body\">\n        <aside className=\"profile__bodyAside\">\n          <ProfileImage className=\"pic\" title=\"Your Profile Picture\" />\n        </aside>\n\n        <main className=\"profile__bodyMain\">\n           <div className=\"nameDiv\">\n           <p className=\"name\">{user?.firstName || \"Nkosingiphile \"} {user?.lastName || \"Mkwanazi\"}</p> <GoVerified id=\"ico\"/>\n              <hr className=\"separator\"/>\n            </div>\n\n          <form>\n          <label htmlFor=\"degree\">\n              <h3>Student number:</h3>\n              <input\n                className=\"textBox\"\n                type=\"email\"\n                name=\"studentNo\"\n                id=\"textbox\"\n                disabled\n                value={user?.studentNumber || \"2017049467\"}\n              />\n            </label>\n            <label htmlFor=\"degree\">\n              <h3>Email:</h3>\n              <input\n                className=\"textBox\"\n                type=\"email\"\n                name=\"email\"\n                id=\"textbox\"\n                value={user?.email || \"email.email.com\"}\n              />\n            </label>\n            <label htmlFor=\"degree\">\n              <h3>Field of study:</h3>\n              <input\n                className=\"textBox\"\n                type=\"text\"\n                name=\"degree\"\n                id=\"textbox\"\n                value={user?.degree || \"Computer Information Systems\"}\n              />\n            </label>\n\n            <label htmlFor=\"degree\">\n              <h3>Bio:</h3>\n              <textarea\n                className=\"bioBox\"\n                name=\"bio\"\n                id=\"bio\"\n                value={user?.bio || \"Hello there...\"}\n              />\n            </label>\n          </form>\n        </main>\n      </section>\n      {/* The page will have image on the left and The rest of the information will be on the right */}\n\n      {/* At the top it will be a logo with the just a heading saying your profile */}\n    </div>\n  );\n}\n\nexport default Profile;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Login/Login.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/Register.js",["135"],"import React, { useEffect } from \"react\";\nimport { useMutation } from \"@apollo/react-hooks\";\nimport { Link } from \"react-router-dom\";\nimport { Button } from \"@material-ui/core\";\n\nimport logo from \"../../logo.png\";\nimport { useForm } from \"../../utils/hooks\";\nimport { REGISTER_USER } from \"../../utils/graphql\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\n\nimport \"./Register.css\";\n\nfunction Register({ history }) {\n  const { onChange, onSubmit, values } = useForm(registerUser, {\n    studentNumber: \"\",\n    firstName: \"\",\n    lastName: \"\",\n    email: \"\",\n    password: \"\",\n    confirmPassword: \"\",\n  });\n  const [, dispatch] = useUserHelpers();\n\n  const [register] = useMutation(REGISTER_USER, {\n    update(_, { data: { register: userData } }) {\n      dispatch({\n        type: \"SET_USER\",\n        payload: userData,\n      });\n\n      history.push(\"/register/finalise\");\n    },\n    variables: values,\n    onError(err) {\n      dispatch({\n        type: \"SET_ERRORS\",\n        payload: err?.graphQLErrors[0]?.extensions?.errors,\n      });\n    },\n  });\n\n  function registerUser() {\n    register();\n  }\n\n  // This code is for testing\n  // const onSubmit = (e) => {\n  //   e.preventDefault();\n\n  //   dispatch({\n  //     type: \"SET_ERRORS\",\n  //     payload: {\n  //       name: \"Name cannot be empty\",\n  //       surname: \"surname cannot be empty\",\n  //       password: \"Password cannot be empty\",\n  //       confirmPassword: \"This should match with password\",\n  //     },\n  //   });\n  // };\n\n  useEffect(() => {\n    document.title = \"Qampus | Register Account\";\n  }, []);\n\n  return (\n    <div className=\"register\">\n      <section className=\"page_headers\">\n        <img  className=\"logo\" src={logo} alt=\"qampus app register user\" />\n        <h1 className=\"welcome_header\">Welcome</h1>\n        <hr className=\"separator\" />\n        <h2 className=\"title\">please register to access all the features</h2>\n\n      </section>\n\n      <section className=\"page_content\">\n        <div className=\"register__aside\">\n          <p className=\"list_tittle\">Why should I create an account?</p> \n          <ul class=\"tilesWrap\">\n            <li>\n              <h2>01</h2>\n              <h3>Advertise to the entire campus</h3>\n              <p>\n              You can upload your used texbooks and connect with thousands of students who are looking to buy them. When you register you can upload 2 textbooks for FREE.\n              </p>\n            </li>\n            <li>\n              <h2>02</h2>\n              <h3>Spend less on textbooks</h3>\n              <p>\n              Save yourself thousands of rands in texbooks fees by buying used texbooks from students who are on your campus.              </p>\n            </li>\n            <li>\n              <h2>03</h2>\n              <h3>Never get lost on campus</h3>\n              <p>\n              Do you have an unfamiliar class venue? Find your way around campus by using our navigation system.\n              </p>\n            </li>\n            <li>\n              <h2>04</h2>\n              <h3>Meet more interesting people</h3>\n              <p>\n              Connect with your peers who are registered on Qampus and get to know them better.\n              </p>\n            </li>\n          </ul>\n        </div>\n\n        <div className=\"register__main\">\n          <form onSubmit={onSubmit} className=\"register__mainForm\">\n          <label htmlFor=\"firstName\">\n            First Name(s): <br />\n            <input\n              type=\"text\"\n              name=\"firstName\"\n              className=\"formInput\"\n              required\n              value={values.firstName}\n              onChange={onChange}\n              id=\"firstName\"\n            />\n          </label>\n\n          <label htmlFor=\"lastName\">\n            Last Name: <br />\n            <input\n              type=\"text\"\n              name=\"lastName\"\n              className=\"formInput\"\n              required\n              value={values.lastName}\n              onChange={onChange}\n              id=\"lastName\"\n            />\n          </label>\n\n          <label htmlFor=\"email\">\n            Email Address: <br />\n            <input\n              type=\"email\"\n              name=\"email\"\n              className=\"formInput\"\n              required\n              value={values.email}\n              onChange={onChange}\n              id=\"email\"\n            />\n          </label>\n\n          <label htmlFor=\"studentNumber\">\n            Student Number: <br />\n            <input\n              type=\"text\"\n              name=\"studentNumber\"\n              className=\"formInput\"\n              required\n              maxLength=\"10\"\n              value={values.studentNumber}\n              onChange={onChange}\n              id=\"studentNumber\"\n            />\n          </label>\n\n          <label htmlFor=\"password\">\n            Password: <br />\n            <input\n              type=\"password\"\n              name=\"password\"\n              className=\"formInput\"\n              required\n              value={values.password}\n              onChange={onChange}\n              id=\"password\"\n            />\n          </label>\n\n          <label htmlFor=\"confirmPassword\">\n            Confirm password: <br />\n            <input\n              type=\"password\"\n              name=\"confirmPassword\"\n              className=\"formInput\"\n              required\n              value={values.confirmPassword}\n              onChange={onChange}\n              id=\"confirmPassword\"\n            />\n          </label>\n\n          <Button type=\"submit\">Sign up</Button>\n\n          {/* Below button for testing */}\n          {/* <Button onClick={onSubmit}>Register</Button>  */}\n        </form>\n        </div>\n       \n      </section>\n      <footer className=\"register__footer\">\n        <hr className=\"separator_footer\" />\n        <span name=\"top_footer\">Qampus &copy; 2020 | All Rights Reserved.</span>\n\n        <span className=\"register__footerSeparator\"></span>\n        <span name=\"bottom_footer\">\n          Developed by Nuclear Software (Pty) Ltd\n        </span>\n      </footer>\n    </div>\n  );\n}\n\nexport default Register;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MessageBox/MessageBox.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/userSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/messagesSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/hooks.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/graphql.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/FinaliseRegister.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/HeaderMenu/HeaderMenu.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/UploadCollection.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/CropImage/CropImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MenuItem/MenuItem.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Contact/Contact.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/booksSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/SearchResult/SearchResult.js",["136","137"],"import React, { useLayoutEffect, useState } from \"react\";\nimport book from \"./book.jpg\";\nimport \"./SearchResult.css\";\n\n\nvar book_description = \"book description from DB goes here\";\nvar date_uploaded = \"date from db goes here\";\n\nfunction SearchResult() {\n  const [width, setWidth] = useState(0);\n\n  // window.onresize = () =>\n  //   console.log(document.querySelector(\".triangle\").style.width);\n\n  // let mounted = true;\n  useLayoutEffect(() => {\n    setWidth(0.7 * (0.61 * window.innerWidth));\n  }, [setWidth]);\n\n  return (\n    <div className=\"searchResult\">\n      <img src={book} alt=\"book result\" className=\"searchResult__img\" />\n      <div className=\"searchResult__description\">\n        <b>ISBN:</b> 9781408046634<br />\n        <b>Title:</b> Database Principles<br />\n        <b>Module Code:</b> CSIS3714 <br />\n        <b>Author:</b> Stephen Morris, David Smith <br />\n        <b>Price:</b> R310,00 <br />\n        <b>Edition: </b>2nd <br />\n      </div>\n      <span className=\"dateContainer\">Uploaded: 17/06/2021</span>\n      <span className=\"triangle\" style={{ width: width + \"px\" }}></span>\n    </div>\n  );\n}\n\nexport default SearchResult;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/getCroppedImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/ProfileImage/ProfileImage.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/Message/Message.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/Upload/Upload.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Upload_Collection/Collection/Collection.js",["138","139","140","141"],{"ruleId":"142","replacedBy":"143"},{"ruleId":"144","replacedBy":"145"},{"ruleId":"146","severity":1,"message":"147","line":19,"column":8,"nodeType":"148","messageId":"149","endLine":19,"endColumn":18},{"ruleId":"146","severity":1,"message":"150","line":6,"column":16,"nodeType":"148","messageId":"149","endLine":6,"endColumn":24},{"ruleId":"146","severity":1,"message":"151","line":17,"column":20,"nodeType":"148","messageId":"149","endLine":17,"endColumn":32},{"ruleId":"146","severity":1,"message":"150","line":1,"column":10,"nodeType":"148","messageId":"149","endLine":1,"endColumn":18},{"ruleId":"146","severity":1,"message":"152","line":9,"column":20,"nodeType":"148","messageId":"149","endLine":9,"endColumn":28},{"ruleId":"146","severity":1,"message":"153","line":3,"column