ndex.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/reportWebVitals.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/ApolloProvider.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/App.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/store.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/getSlices.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/utils/AuthRoute.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Home/Home.js",["92"],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Chats/Chats.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Profile/Profile.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/HeaderMenu/HeaderMenu.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Login/Login.js",["93"],"import React, { useEffect } from \"react\";\nimport { Button } from \"@material-ui/core\";\nimport { Link } from \"react-router-dom\";\nimport { useMutation } from \"@apollo/react-hooks\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\nimport { useForm } from \"../../utils/hooks\";\nimport logo from \"../../logo.png\";\nimport { LOGIN_USER } from \"../../utils/graphql\";\nimport \"./Login.css\";\n\nfunction Login({ history }) {\n  const [{ path }, dispatch] = useUserHelpers();\n  const { onChange, onSubmit, values } = useForm(loginUser, {\n    studentNumber: \"\",\n    password: \"\",\n  });\n  // console.log(history);\n\n  const [login, { loading }] = useMutation(LOGIN_USER, {\n    update(_, { data: { login: userData } }) {\n      dispatch({ type: \"SET_USER\", payload: userData });\n      (path && history.push(path)) || history.goBack();\n    },\n    variables: values,\n    onError(err) {\n      console.log(err);\n    },\n  });\n\n  function loginUser() {\n    login();\n  }\n\n  useEffect(() => {\n    document.title = \"Qampus | Login to Account\";\n  }, []);\n\n  return (\n    <div className=\"login\">\n      <header className=\"login__header\">\n        <img className=\"login__headerLogo\" src={logo} alt=\"qampus logo\" />\n      </header>\n      <div className=\"welcome__text\">\n        <p>Welcome to Qampus</p>\n        <hr className=\"separator\"/>\n\n      </div>\n      <main className=\"login__main\">\n        <h3 className=\"title\">login to access all the features</h3>\n\n        <form className=\"form\" onSubmit={onSubmit}>\n          <label htmlFor=\"studentNum\">\n            Student Number: <br />\n            <input\n              type=\"text\"\n              name=\"studentNumber\"\n              className=\"form__idInput\"\n              required\n              maxLength=\"10\"\n              value={values.studentNumber}\n              onChange={onChange}\n              id=\"studentNum\"\n            />\n          </label>\n\n          <label htmlFor=\"password\">\n            Password: <br />\n            <input\n              type=\"password\"\n              name=\"password\"\n              id=\"password\"\n              required\n              value={values.password}\n              onChange={onChange}\n              className=\"form__passwordInput\"\n            />\n          </label>\n          \n          <div className=\"form__btns\">\n            <Button type=\"submit\" className=\"form__btnSubmit\">\n              Login\n            </Button>\n            \n            <div className=\"links\">\n              <Link className=\"form__signupLink\" to=\"/register\">\n                Sign up\n              </Link>\n              <p>or</p>\n              <Link className=\"form__guestLink\" to=\"/\">\n                continue as a guest\n                {/* When the user chooses this option, a function \n                should prevent them from accessing the full featuers*/}\n              </Link>\n            </div>\n            \n          </div>\n        </form>\n      </main>\n     \n      <footer className=\"login__footer\">\n      <hr className=\"separator_footer\"/>\n        <span name=\"top_footer\">Qampus &copy; 2020 | All Rights Reserved.</span>\n\n        <span className=\"login__footerSeparator\"></span>\n        <span name=\"bottom_footer\">Developed by Nuclear Software (Pty) Ltd</span>\n      </footer>\n    </div>\n  );\n}\n\nexport default Login;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Register/Register.js",["94"],"import React, { useEffect } from \"react\";\nimport { useMutation } from \"@apollo/react-hooks\";\nimport { Link } from \"react-router-dom\";\nimport { Button } from \"@material-ui/core\";\n\nimport logo from \"../../logo.png\";\nimport { useForm } from \"../../utils/hooks\";\nimport { REGISTER_USER } from \"../../utils/graphql\";\nimport { useUserHelpers } from \"../../Redux/getSlices\";\n\nimport \"./Register.css\";\n\nfunction Register({ history }) {\n  const { onChange, onSubmit, values } = useForm(registerUser, {\n    studentNumber: \"\",\n    firstName: \"\",\n    lastName: \"\",\n    email: \"\",\n    password: \"\",\n    confirmPassword: \"\",\n  });\n  const [{ path }, dispatch] = useUserHelpers();\n\n  const [register, { loading }] = useMutation(REGISTER_USER, {\n    update(_, { data: { register: userData } }) {\n      dispatch({\n        type: \"SET_USER\",\n        payload: userData,\n      });\n\n      (path && history.push(path)) || history.goBack();\n    },\n    variables: values,\n    onError(err) {\n      dispatch({\n        type: \"SET_ERRORS\",\n        payload: err?.graphQLErrors[0]?.extensions?.errors,\n      });\n    },\n  });\n\n  function registerUser() {\n    register();\n  }\n\n  // This code is for testing\n  // const onSubmit = (e) => {\n  //   e.preventDefault();\n\n  //   dispatch({\n  //     type: \"SET_ERRORS\",\n  //     payload: {\n  //       name: \"Name cannot be empty\",\n  //       surname: \"surname cannot be empty\",\n  //       password: \"Password cannot be empty\",\n  //       confirmPassword: \"This should match with password\",\n  //     },\n  //   });\n  // };\n\n  useEffect(() => {\n    document.title = \"Qampus | Register Account\";\n  }, []);\n\n  return (\n    <div className=\"register\">\n      <h1 className=\"title\">Welcome to Qampus</h1>\n      <aside className=\"register__aside\">\n        <img src={logo} alt=\"qampus app register user\" />\n        <h1>Connect with other students</h1>\n        <h1>Have others come to you to buy books</h1>\n        <h1>Easily buy books from other students</h1>\n        <h1>Find your way around your campus</h1>\n        <h1>\n          Create Your Account Now{\" \"}\n          <span role=\"img\" aria-label=\"right pointing finger\">\n            👉\n          </span>{\" \"}\n        </h1>\n        <p>\n          Already have an account? <Link to=\"login\">Login</Link>\n        </p>\n      </aside>\n\n      <main className=\"register__main\">\n        <h4 className=\"subtitle\">Sign up for more features</h4>\n\n        <form onSubmit={onSubmit} className=\"register__mainForm\">\n          <label htmlFor=\"firstName\">\n            First Name(s): <br />\n            <input\n              type=\"text\"\n              name=\"firstName\"\n              className=\"formInput\"\n              required\n              value={values.firstName}\n              onChange={onChange}\n              id=\"firstName\"\n            />\n          </label>\n\n          <label htmlFor=\"lastName\">\n            Last Name: <br />\n            <input\n              type=\"text\"\n              name=\"lastName\"\n              className=\"formInput\"\n              required\n              value={values.lastName}\n              onChange={onChange}\n              id=\"lastName\"\n            />\n          </label>\n\n          <label htmlFor=\"email\">\n            Email Address: <br />\n            <input\n              type=\"email\"\n              name=\"email\"\n              className=\"formInput\"\n              required\n              value={values.email}\n              onChange={onChange}\n              id=\"email\"\n            />\n          </label>\n\n          <label htmlFor=\"studentNumber\">\n            Student Number: <br />\n            <input\n              type=\"text\"\n              name=\"studentNumber\"\n              className=\"formInput\"\n              required\n              maxLength=\"10\"\n              value={values.studentNumber}\n              onChange={onChange}\n              id=\"studentNumber\"\n            />\n          </label>\n\n          <label htmlFor=\"password\">\n            Password: <br />\n            <input\n              type=\"password\"\n              name=\"password\"\n              className=\"formInput\"\n              required\n              value={values.password}\n              onChange={onChange}\n              id=\"password\"\n            />\n          </label>\n\n          <label htmlFor=\"confirmPassword\">\n            Confirm password: <br />\n            <input\n              type=\"password\"\n              name=\"confirmPassword\"\n              className=\"formInput\"\n              required\n              value={values.confirmPassword}\n              onChange={onChange}\n              id=\"confirmPassword\"\n            />\n          </label>\n\n          <Button type=\"submit\">Register</Button>\n\n          {/* Below button for testing */}\n          {/* <Button onClick={onSubmit}>Register</Button>  */}\n        </form>\n      </main>\n    </div>\n  );\n}\n\nexport default Register;\n","/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/components/MessageBox/MessageBox.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/userSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/Redux/features/messagesSlice.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/client/src/pages/Home/MenuItem.js",[],"/home/mphile/Desktop/repos/nduduzo/qampus-app/clien